# Alpha-N — environment template
# Copy to `.env` and adjust. NEVER commit the real .env (it's gitignored).

# SQLite database location. Defaults to <project>/db/custom.db when omitted.
# Use forward slashes so Prisma parses it consistently on Windows + Linux.
# DATABASE_URL=file:./db/custom.db

# Project root for AI file operations. Defaults to process.cwd() (the dir
# you launch the server from). Override only if you run the server from
# elsewhere and want the AI scoped to the repo.
# ALPHA_PROJECT_ROOT=/absolute/path/to/Alpha-N

# Sandbox directory for AI code execution. Defaults to <os-tmpdir>/alpha-sandbox.
# Kept OUTSIDE the project root so spawned code can't read your source.
# ALPHA_SANDBOX_ROOT=/tmp/alpha-sandbox
