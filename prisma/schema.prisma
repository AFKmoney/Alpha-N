// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Alpha-OS — Persistent Cognition Layer (Akasha)
// The AI's immortal memory. Survives reloads. Never forgets.
// ============================================================

// Permanent memories — lessons, facts, architecture notes
model AkashaMemory {
  id        String   @id @default(cuid())
  text      String
  kind      String   @default("lesson") // lesson | fact | architecture
  createdAt DateTime @default(now())
}

// TODOs the AI sets for itself
model AkashaIntention {
  id        String   @id @default(cuid())
  text      String
  priority  String   @default("normal") // low | normal | high
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Multi-step plans for long-horizon reasoning
model Plan {
  id          String   @id @default(cuid())
  goal        String
  rationale   String
  status      String   @default("active") // active | completed | abandoned
  stepsJson   String   @default("[]") // JSON array of {text, done}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Long-term goals — the AI's persistent desires
model Goal {
  id          String   @id @default(cuid())
  text        String
  level       String   @default("long") // long | medium | short
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Event log — reactive events the AI should know about
model SystemEvent {
  id        String   @id @default(cuid())
  type      String // terminal_output | error | file_change | user_message | mutation
  content   String
  createdAt DateTime @default(now())
}

// Reward model — tracks which mutations helped vs hurt coherence
model MutationReward {
  id           String   @id @default(cuid())
  mutationKind String
  description  String
  coherenceBefore Float
  coherenceAfter  Float
  delta        Float
  helpful      Boolean
  createdAt    DateTime @default(now())
}

// User preferences — persisted OS state per user
model UserPreference {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Custom wallpapers created by the AI or user
model Wallpaper {
  id        String   @id @default(cuid())
  name      String
  presetId  String   // the generative art preset identifier
  config    String   @default("{}") // JSON config (colors, speed, etc.)
  isCustom  Boolean  @default(false) // true if AI-generated
  createdAt DateTime @default(now())
}

// ============================================================
// Alpha-OS — AI App Store
// Apps generated by the AI on demand. The full React component
// source code is stored as text and rendered at runtime by the
// GeneratedAppRenderer (sandboxed execution via `new Function`).
// ============================================================
model GeneratedApp {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   @default("Productivity") // Productivity | Creative | Developer | Utilities | AI Tools | Fun
  code        String   // full React component source (TSX-shaped, "use client" + export function)
  createdAt   DateTime @default(now())
}

// ============================================================
// Alpha-OS — Episodic Memory (Phase 1: self-awareness)
// Every action the AI takes is logged here with the result,
// the reward, and a screenshot. The AI re-reads this journal
// every cycle to learn from its past actions.
// ============================================================
model EpisodeLog {
  id          String   @id @default(cuid())
  cycle       Int      // which autonomous cycle this action was part of
  action      String   // the mutation type (e.g. "replace_code", "create_app")
  description String   // human-readable description
  reasoning   String   @default("") // why the AI did this
  result      String   @default("") // "ok", "error", "blocked", "rollback"
  reward      Float    @default(0) // -1.0 to +1.0 (user feedback + auto metrics)
  screenshot  String   @default("") // base64 screenshot after the action (optional)
  timestamp   DateTime @default(now())
}

// ============================================================
// Alpha-OS — User Constraints (Phase 4: granular control)
// The user can set constraints like "don't touch the kernel"
// or "only improve the UI, not the backend". The AI must obey.
// ============================================================
model Constraint {
  id        String   @id @default(cuid())
  text      String   // the constraint text
  scope     String   @default("global") // global | code | ui | files
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
